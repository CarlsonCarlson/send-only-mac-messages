{
  "schemaVersion": 1,
  "publication": {
    "hostname": "__PUBLIC_HOST__",
    "path": "/mcp",
    "preserveHost": true,
    "service": "http://127.0.0.1:__LOOPBACK_PORT__"
  },
  "waf": {
    "mcpHost": {
      "allowExactPath": "/mcp",
      "denyAllOtherPaths": true,
      "hostname": "__PUBLIC_HOST__"
    }
  },
  "rateLimit": {
    "action": "block",
    "characteristics": [
      "ip.src",
      "cf.colo.id"
    ],
    "hostnames": [
      "__PUBLIC_HOST__"
    ],
    "mitigationTimeoutSeconds": 10,
    "path": "/mcp",
    "periodSeconds": 10,
    "requestsPerPeriod": 20
  }
}
